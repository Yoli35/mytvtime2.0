<menu class="tab-menu" id="{{ menuId }}">
    {% for item in list %}
        <li id="{{ menuId }}-{{ item.id }}" data-index="{{ loop.index0 }}" class="{{ class }}{% if loop.index0 == tab %} active{% endif %}" data-title="{{ item.title }}">
            {{ item.icon|raw }}{{ item.text }}
        </li>
    {% endfor %}
    <li class="active-menu"></li>
</menu>
