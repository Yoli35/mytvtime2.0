<div class="card{% if series.episode_number==1 %} premiere{% endif %}"{% if next==0 %} data-prev-id="{{ series.prev_episode_id }}"{% endif %}>
    <a href="{{ path('app_tv_episode', { 'id': series.id, slug: series.name|slug, seasonNumber: series.season_number, episodeNumber: series.episode_number }) }}">
        <div class="poster">
            {% if series.poster_path is defined and series.poster_path %}
                <img src="/series/posters{{ series.poster_path }}" alt="{{ series.name }}">
            {% else %}
                <div>{{ 'No poster'|trans }}</div>
            {% endif %}
        </div>
        <div class="infos">
            <div class="details">
                <div class="name">{{ series.name }}</div>
                {% if next and  series.viewedCount>0 %}
                    <div class="progress-wrapper" data-title="{{ series.viewedCount }} {{ 'ep.Viewed'|trans }}<br>{{ series.airedCount }} {{ 'ep.Aired'|trans }}<br>{{ series.episodeCount }} {{ 'ep.Total'|trans }}">
                        <div class="progress-content"></div>
                        <div class="progress-bar-aired" style="width: {{ series.airedCount/series.episodeCount*100 }}%"></div>
                        <div class="progress-bar-viewed" style="width: {{ series.viewedCount/series.episodeCount*100 }}%"></div>
                    </div>
                {% endif %}
                {% if series.remainingEpisodeCount==0 %}
                    <div class="status">{{ 'End of season'|trans }}</div>
                {% endif %}
                <div class="status">
                    {% if series.remainingEpisodeCount == 1 %}
                        <div class="last">{{ 'Last episode'|trans }}</div>
                    {% elseif series.episode_number == 1 and series.season_number > 1 %}
                        <div class="new">{{ 'New season'|trans }}</div>
                    {% else %}
                        {{ series.remainingEpisodeCount }} {{ 'remaining episodes'|trans }}
                    {% endif %}
                </div>
                {#                <div class="status">{{ series.remainingEpisodeCount }} {{ (series.remainingEpisodeCount>1 ?'remaining episodes':'remaining episode')|trans }}</div> #}
                <div class="number">
                    {% if next %}
                        {{ series.number }}
                        {% if series.sinceDays>0 %}
                            <span>{{ 'Since'|trans }} {{ series.sinceDays }} {{ (series.sinceDays>1?'days':'day')|trans }}</span>
                        {% else %}
                            <span class="green">{{ 'Today'|trans }}</span>
                        {% endif %}
                    {% else %}
                        {{ series.number }}
                        {% if series.remaingDays>0 %}
                            <span>{{ 'In'|trans }} {{ series.remaingDays }} {{ (series.remaingDays>1?'days':'day')|trans }}</span>
                        {% else %}
                            <span class="green">{{ 'Today'|trans }}</span>
                        {% endif %}
                    {% endif %}
                </div>
                {% if series.esn_name %}
                    <div class="esn-name" data-title="{{ series.esn_name }}">{{ series.esn_name }}</div>
                {% endif %}
            </div>

            {% set wps = watchLinks|filter((wp) => wp.seriesId == series.id and (wp.seasonNumber == -1 or wp.seasonNumber == series.season_number)) %}
            <div class="watch-links">
                {% for wp in wps %}
                    <div class="watch-link" data-title="{{ wp.dataTitle }}" data-link="{{ wp.link }}">
                        <img src="{{ wp.providerLogoPath }}" alt="{{ wp.providerName }}">
                    </div>
                {% endfor %}
            </div>

            {% if next %}
                <div class="add-badge"
                     data-episode-id="{{ series.episode_id }}"
                     data-episode-number="{{ series.episode_number }}"
                     data-season-number="{{ series.season_number }}"
                     data-series-id="{{ series.id }}"
                     data-tmdb-id="{{ series.tmdb_id }}"
                     data-user-episode-id="{{ series.userEpisodeId }}"
                >{{ ux_icon('mdi:eye') }}</div>
            {% else %}
                <div class="vote" data-id="{{ series.userEpisodeId }}">{% if series.prev_episode_vote %}{{ series.prev_episode_vote }}{% else %}{{ ux_icon('mdi:star') }}{% endif %}</div>
                <div class="done">{{ ux_icon('mdi:check') }}</div>
            {% endif %}
        </div>
    </a>
</div>