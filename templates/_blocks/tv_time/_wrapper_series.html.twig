<div class="wrapper{% if list %} list{% endif %}">
    <div class="content">
        {% for series in seriesAvailable %}
            {{ include('_blocks/tv_time/_card_series.html.twig', {next: true}) }}
        {% endfor %}
        {% for series in seriesUpToDate %}
            {{ include('_blocks/tv_time/_card_series.html.twig', {next: false}) }}
        {% endfor %}
    </div>
    {% if app.environment == 'dev' %}
        <div class="count">{{ loadCount }}</div>
    {% endif %}
</div>