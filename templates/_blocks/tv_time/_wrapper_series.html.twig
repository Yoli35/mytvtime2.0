<div class="wrapper{% if list %} list{% endif %}">
    <div class="content">
        {% for series in seriesAvailable %}
            {{ include('_blocks/tv_time/_card_series.html.twig', {next: true, while: false}) }}
        {% endfor %}
    </div>
    {% if specialEpisodes|length %}
        <div class="divider" data-content="specials"><span>{{ 'Specials'|trans }} ({{ specialEpisodes|length }})</span></div>
        <div class="content">
            {% for series in specialEpisodes %}
                {{ include('_blocks/tv_time/_card_series.html.twig', {next: true, while: false}) }}
            {% endfor %}
        </div>
    {% endif %}
    {% if seriesUpToDate|length %}
        <div class="divider" data-content="up-to-date"><span>{{ 'Up to date'|trans }} ({{ seriesUpToDate|length }})</span></div>
        <div class="content">
            {% for series in seriesUpToDate %}
                {{ include('_blocks/tv_time/_card_series.html.twig', {next: false, while: false}) }}
            {% endfor %}
        </div>
    {% endif %}
    {% if seriesEnded|length %}
        <div class="divider" data-content="ended"><span>{{ 'Ended'|trans }}</span> <span class="counts">({{ seriesEnded|length }}/{{ seriesEndedCount }})</span></div>
        <div class="content" data-content="ended">
            {% for series in seriesEnded %}
                {{ include('_blocks/tv_time/_card_series_ended.html.twig') }}
            {% endfor %}
            {% if seriesEndedCount > seriesEnded|length %}
                <button type="button" class="show-more" data-content="ended" data-offset="{{ seriesEnded|length }}">{{ 'tv-time.show-more'|trans }}</button>
            {% endif %}
        </div>
    {% endif %}
    {% if upToDateInAWhileCount %}
        <div class="divider" data-content="not-watched-in-a-while"><span>{{ 'Not watched in a while'|trans }}</span> <span class="counts">({{ upToDateInAWhile|length }}/{{ upToDateInAWhileCount }})</span></div>
        <div class="content" data-content="not-watched-in-a-while">
            {% for series in upToDateInAWhile %}
                {{ include('_blocks/tv_time/_card_series.html.twig', {next: false, while: true}) }}
            {% endfor %}
            {% if upToDateInAWhileCount > upToDateInAWhile|length %}
                <button type="button" class="show-more" data-content="not-watched-in-a-while" data-offset="{{ upToDateInAWhile|length }}">{{ 'tv-time.show-more'|trans }}</button>
            {% endif %}
        </div>
    {% endif %}
    {% if app.environment == 'dev' %}
        <div class="count">{{ loadCount }}</div>
    {% endif %}
</div>