<dialog id="discoverTvSettingsDialog" class="discover-tv-settings-dialog" closedby="any">
    <form>
        <label for="discover_tv_list">{{ 'Lists'|trans }}:
            <select class="" id="discover_tv_list">
            </select>
        </label>
        <label for="discover_tv_order_by">{{ 'Sort by'|trans }}:
            <select class="" id="discover_tv_order_by">
                <option value=""></option>
                <option value="first_air_date.asc">first_air_date.asc</option>
                <option value="first_air_date.desc">first_air_date.desc</option>
                <option value="name.asc">name.asc</option>
                <option value="name.desc">name.desc</option>
                <option value="original_name.asc">original_name.asc</option>
                <option value="original_name.desc">original_name.desc</option>
                <option value="popularity.asc">popularity.asc</option>
                <option value="popularity.desc">popularity.desc</option>
                <option value="vote_average.asc">vote_average.asc</option>
                <option value="vote_average.desc">vote_average.desc</option>
                <option value="vote_count.asc">vote_count.asc</option>
                <option value="vote_count.desc">vote_count.desc</option>
            </select>
        </label>
        <div class="row">
            {#<button type="reset">{{ 'Reset'|trans }}</button>#}
            <button type="button">{{ 'Cancel'|trans }}</button>
            <button type="submit">{{ 'Close'|trans }}</button>
        </div>
    </form>
</dialog>
