<div class="card{% if next and series.episode_number==1 %} premiere{% endif %}">
    <a href="{{ path('app_tv_episode', { 'id': series.id, slug: series.name|slug, seasonNumber: series.season_number, episodeNumber: series.episode_number }) }}">
        <div class="poster">
            {% if series.poster_path is defined and series.poster_path %}
                <img src="/series/posters{{ series.poster_path }}" alt="{{ series.name }}">
            {% else %}
                <div>{{ 'No poster'|trans }}</div>
            {% endif %}
        </div>
        <div class="infos tv-time">
            <div class="name">
                {{ series.name }}
                {% if next and series.last %}{{ 'End of season'|trans }}{% endif %}
                <em>{% if next %}{{ series.number }}{% else %}{{ 'Up to date'|trans }}{% endif %}</em>
            </div>
            {% if next %}
                <div class="add-badge"
                     data-episode-id="{{ series.episode_id }}"
                     data-episode-number="{{ series.episode_number }}"
                     data-last-episode="{{ series.last }}"
                     data-season-number="{{ series.season_number }}"
                     data-series-id="{{ series.id }}"
                     data-tmdb-id="{{ series.tmdb_id }}"
                     data-user-episode-id="{{ series.userEpisodeId }}"
                >{{ ux_icon('mdi:eye') }}</div>
            {% else %}
                <div class="done">{{ ux_icon('mdi:check') }}</div>
            {% endif %}
        </div>
    </a>
</div>