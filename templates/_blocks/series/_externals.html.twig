{% if externals|length %}
    <div class="externals">
        <h2>
            {{ 'External sources'|trans }}
        </h2>
        <div class="wrapper">
            {% for e in externals %}
                <div class="external" data-title="{{ e.name }}">
                    <a href="{{ e.fullUrl }}" target="_blank" rel="noopener noreferrer">
                        {% if e.logoPath %}
                            <img src="{{ e.logoPath }}" alt="{{ e.name }}">
                        {% else %}
                            <div>{{ e.name }}</div>
                        {% endif %}
                    </a>
                </div>
            {% endfor %}
        </div>
    </div>
    <script>
        const seriesShowDiv = document.querySelector('.series-show');
        const wrapper = document.querySelector('.externals .wrapper');
        const externalDivs = wrapper.querySelectorAll('.external');
        const externalDiv = wrapper.querySelector('.external');
        const externalDivWidth = externalDiv.offsetWidth;
        const externalCount = externalDivs.length;
        window.addEventListener('resize', () => {
            const availableWidth = seriesShowDiv.offsetWidth;
            if (externalCount * externalDivWidth + (externalCount - 1) * 16 > availableWidth) {
                for (let i = 2; i <= externalCount; i++) {
                    const countByLine = Math.ceil(externalCount / i);
                    const idealWrapperWidth = countByLine * externalDivWidth + (countByLine - 1) * 16; // gap: 16px
                    if (idealWrapperWidth <= availableWidth) {
                        wrapper.style.width = idealWrapperWidth + 'px';
                        break;
                    }
                }
            } else {
                wrapper.style.width = "unset";
            }
        });
    </script>
{% endif %}
