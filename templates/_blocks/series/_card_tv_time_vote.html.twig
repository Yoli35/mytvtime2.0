<div class="last-episode-votes">
    {% for series in seriesArr %}
        <div class="last-episode-vote" data-id="{{ series.episode_id }}">
            <div class="content">
                <div class="poster">
                    {% if series.poster_path %}
                        <img src="/series/posters{{ series.poster_path }}" alt="{{ series.name }}"/>
                    {% else %}
                        {{ 'No poster'|trans }}
                    {% endif %}
                    <div class="your-vote">--</div>
                </div>
                <div class="infos">
                    <div class="name">
                        {{ series.name }}
                        <span class="episode-number">{{ 'S%02dE%02d'|format(series.episode_season, series.episode_number) }}</span>
                        {% if series.isLastEpisode > 0 %}
                            <span class="last-episode">{{ 'Last episode!'|trans }}</span>
                        {% endif %}
                    </div>
                    {% if series.esn_name %}
                        <div class="esn-name" data-title="{{ series.esn_name }}">{{ series.esn_name }}</div>
                    {% endif %}
                    <div class="vote">
                        {% for vote in 1..12 %}
                            <div class="vote-star" data-vote="{{ vote }}" data-title="{{ vote }}">
                                {{ ux_icon('mdi:star-outline', {'data-status': 'off'}) }}
                                {{ ux_icon('mdi:star', {'data-status': 'on'}) }}
                            </div>
                        {% endfor %}
                    </div>
                    <div class="submit-vote">
                        <a class="btn"
                           href="{{ path('app_tv_episode', {'id': series.id, slug: series.name|slug, seasonNumber: series.episode_season, episodeNumber: series.episode_number}) }}"
                           target="_blank"
                        >
                            {{ 'Go to episode'|trans }}
                        </a>
                        <button type="button" class="btn" data-id="{{ series.episode_id }}" data-is-last-episode="{{ series.isLastEpisode }}">{{ 'Vote'|trans }}</button>
                    </div>
                </div>
            </div>
        </div>
    {% endfor %}
</div>