{% extends 'base.html.twig' %}

{% import 'personal_video/_macros.html.twig' as pv %}

{% block title %}my Tv Time → {{ 'My videos'|trans }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('styles/video.scss') }}">
{% endblock %}

{% block body %}
    {{ include('_blocks/_menu.html.twig') }}
    <div class="container-fluid videos-page personal-videos-page"{% if hasPending %} data-has-pending{% endif %} style="background-image: url('{{ bgImage }}'); background-size: cover; background-position: center;">
        <h1>{{ 'My videos'|trans }} ({{ videos|length }})</h1>
        <div class="video-tools">
            <form id="upload-form" action="{{ path('app_video_personal_upload') }}" method="post" enctype="multipart/form-data">
                <input type="hidden" name="_token" value="{{ csrf_token('personal_video_upload') }}">
                <div class="form-group">
                    <label for="videos"><span>{{ 'Add videos'|trans }}</span>
                        <input type="file" id="videos" name="videos[]" accept="video/*,.mov" multiple required>
                    </label>
                    <span class="max-size">{{ 'Max. size'|trans }} : {{ (maxFileSize / 1073741824)|round }} Go</span>
                    <button type="submit" id="upload-videos">{{ 'Add'|trans }}</button>
                </div>
            </form>
            <ol class="upload-progress"></ol>
        </div>
        <div class="video-wrapper">
            {% for video in videos %}
                <div class="video{% if not video.ready %} {{ video.status }}{% endif %}">
                    <div class="thumbnail">
                        <a href="{{ path('app_video_personal_show', {'id': video.id}) }}">
                            {% if video.thumbnail %}
                                <img src="/videos/personal/{{ video.user.id }}/thumbnails/{{ video.thumbnail }}" alt="{{ video.title }}" loading="lazy">
                            {% else %}
                                <div class="placeholder">
                                    {{ ux_icon(video.status == 'failed' ? 'mdi:alert-circle-outline' : 'mdi:progress-clock') }}
                                    <span>{{ pv.status(video) }}</span>
                                </div>
                            {% endif %}
                        </a>
                        {% if video.duration %}
                            <div class="duration">{{ pv.duration(video.duration) }}</div>
                        {% endif %}
                    </div>
                    <div class="infos">
                        <div class="content">
                            <div class="title">{{ video.title }}</div>
                            <div class="at">
                                {% if video.recordedAt %}
                                    <div class="published-at" data-title="{{ 'Recorded at'|trans }}">{{ ux_icon('mdi:video-outline') }} {{ video.recordedAt|format_datetime('relative_short', 'short') }}</div>
                                {% endif %}
                                <div class="added-at" data-title="{{ 'Added at'|trans }}">{{ ux_icon('mdi:upload') }} {{ video.createdAt|format_datetime('relative_short', 'short') }}</div>
                            </div>
                        </div>
                    </div>
                </div>
            {% else %}
                <div class="no-video">
                    <img src="{{ asset('images/interface/novideo.webp') }}" alt="{{ 'No video'|trans }}">
                    <p>{{ 'No video'|trans }}</p>
                </div>
            {% endfor %}
        </div>
    </div>
    <div id="global-data" style="display: none">
        {
            "app_video_personal_upload_start": "{{ path('app_video_personal_upload_start') }}",
            "app_video_personal_upload_chunk": "{{ path('app_video_personal_upload_chunk') }}",
            "app_video_personal_upload_finish": "{{ path('app_video_personal_upload_finish') }}",
            "app_video_personal_upload_cancel": "{{ path('app_video_personal_upload_cancel') }}",
            "maxFileSize": {{ maxFileSize }},
            "texts": {
                "Waiting": {{ 'Waiting'|trans|json_encode|raw }},
                "Processing": {{ 'Processing'|trans|json_encode|raw }},
                "Done": {{ 'Done'|trans|json_encode|raw }},
                "File too large": {{ 'File too large'|trans|json_encode|raw }},
                "Not a video file": {{ 'Not a video file'|trans|json_encode|raw }},
                "Upload failed": {{ 'Upload failed'|trans|json_encode|raw }}
            }
        }
    </div>
    {% include '_blocks/_footer.html.twig' %}
{% endblock %}
