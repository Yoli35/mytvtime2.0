{% extends 'base.html.twig' %}

{% import 'personal_video/_macros.html.twig' as pv %}

{% block title %}my Tv Time → {{ video.title }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('styles/video.scss') }}">
{% endblock %}

{% block body %}
    {{ include('_blocks/_menu.html.twig') }}
    {% set dir = '/videos/personal/' ~ video.user.id %}
    <div class="container-fluid video-page personal-video-page">
        <div class="back">
            <a href="{{ path('app_video_personal_index') }}">{{ ux_icon('mdi:arrow-left') }} {{ 'My videos'|trans }}</a>
        </div>
        <h1>{{ video.title }}</h1>
        {% if video.ready %}
            <div class="player{% if video.portrait %} portrait{% endif %}">
                <video controls playsinline preload="metadata"
                       {% if video.thumbnail %}poster="{{ dir }}/thumbnails/{{ video.thumbnail }}"{% endif %}
                        {% if video.width and video.height %}style="aspect-ratio: {{ video.width }}/{{ video.height }}"{% endif %}>
                    <source src="{{ dir }}/{{ video.filename }}" type="video/mp4">
                </video>
            </div>
        {% else %}
            <div class="player status {{ video.status }}">
                <div class="placeholder">
                    {{ ux_icon(video.status == 'failed' ? 'mdi:alert-circle-outline' : 'mdi:progress-clock') }}
                    <span>{{ pv.status(video) }}</span>
                    {% if video.error %}
                        <pre class="error">{{ video.error }}</pre>{% endif %}
                </div>
            </div>
        {% endif %}
        <div class="details">
            {% if video.duration %}
                <div>{{ 'Duration'|trans }} : {{ pv.duration(video.duration) }}</div>{% endif %}
            {% if video.width %}
                <div>{{ video.width }}×{{ video.height }}</div>{% endif %}
            {% if video.size %}
                <div>{{ (video.size / 1048576)|round(1) }} Mo</div>{% endif %}
            {% if video.recordedAt %}
                <div>{{ 'Recorded at'|trans }} : {{ video.recordedAt|format_datetime('long', 'short') }}</div>{% endif %}
            <div>{{ 'Added at'|trans }} : {{ video.createdAt|format_datetime('long', 'short') }}</div>
        </div>
        {% if video.description %}
            <div class="description">{{ video.description|nl2br }}</div>
        {% endif %}
        <div class="video-tools">
            <form id="edit-form" action="{{ path('app_video_personal_edit', {'id': video.id}) }}" method="post" class="edit">
                <input type="hidden" name="_token" value="{{ csrf_token('personal_video_edit_' ~ video.id) }}">
                <div class="form-group">
                    <label for="title"><span>{{ 'Title'|trans }}</span>
                        <input type="text" id="title" name="title" value="{{ video.title }}" maxlength="255" required>
                    </label>
                </div>
                <div class="form-group">
                    <label for="description"><span>{{ 'Description'|trans }}</span>
                        <textarea id="description" name="description" rows="4">{{ video.description }}</textarea>
                    </label>
                </div>
                <div class="form-group">
                    <div class="thumbnail-toggler">{{ ux_icon('mdi:settings') }}</div>
                    <div class="foldable folded">
                        <label for="thumbnail"><span>{{ 'Vignette'|trans }}</span>
                            <input type="file" id="thumbnail" name="thumbnail">
                        </label>
                        <div class="preview-thumbnail"></div>
                    </div>
                </div>
                <button type="submit">{{ 'Save'|trans }}</button>
            </form>
            <form action="{{ path('app_video_personal_delete', {'id': video.id}) }}" method="post" onsubmit="return confirm('{{ 'Delete this video?'|trans|e('js') }}')">
                <input type="hidden" name="_token" value="{{ csrf_token('personal_video_delete_' ~ video.id) }}">
                <button type="submit" class="delete">{{ ux_icon('mdi:delete-outline') }} {{ 'Delete'|trans }}</button>
            </form>
        </div>
    </div>
    {% include '_blocks/_footer.html.twig' %}
{% endblock %}
{% block javascripts %}
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            let imageCount = 0;
            const toggler = document.querySelector('.thumbnail-toggler');
            if (toggler) {
                toggler.addEventListener('click', () => {
                    const foldable = toggler.parentElement.querySelector('.foldable');
                    foldable.classList.toggle('folded');
                });
            }
            const editForm = document.getElementById('edit-form');
            if (!editForm) return;
            const imageFiles = editForm.querySelector('input[name="thumbnail"]');
            imageFiles.addEventListener("change", updateImageDisplay);

            // Les images peuvent aussi être ajoutées par copier-coller, n'importe où dans le panneau
            document.addEventListener('paste', function (e) {
                const pastedFiles = Array.from(e.clipboardData?.files || []).filter(file => file.type.startsWith('image/'));
                if (!pastedFiles.length) return;
                e.preventDefault();

                const dataTransfer = new DataTransfer();
                Array.from(imageFiles.files).forEach(file => dataTransfer.items.add(file));
                pastedFiles.forEach(function (file, index) {
                    // Les images collées s'appellent souvent toutes "image.png" : la vignette est retrouvée par son nom
                    const extension = file.type.split('/')[1].replace('jpeg', 'jpg');
                    const name = 'pasted-' + Date.now() + '-' + index + '.' + extension;
                    dataTransfer.items.add(new File([file], name, {type: file.type}));
                });
                imageFiles.files = dataTransfer.files;
                imageFiles.dispatchEvent(new Event('change'));
            });

            function updateImageDisplay(e) {
                const input = e.target;
                const inputName = input.name;
                const preview = editForm.querySelector('.preview-' + inputName);
                const existingList = preview.querySelector('ol');
                existingList?.remove();

                const curFiles = input.files;
                if (curFiles.length === 0) {
                    const div = document.createElement("div");
                    div.textContent = "No files currently selected for upload";
                    preview.appendChild(div);
                    return;
                }

                const list = document.createElement("ol");
                list.classList.add('thumbnail-list');
                preview.appendChild(list);

                let index = imageCount;
                for (const file of curFiles) {
                    const listItem = document.createElement("li");
                    listItem.classList.add("thumbnail-item");
                    if (validFileType(file)) {
                        const radio = document.createElement("input");
                        radio.id = "thumbnail-" + index;
                        radio.type = "radio";
                        radio.name = "thumbnail";
                        radio.value = file.name;
                        if (index === 0) radio.checked = true;
                        const label = document.createElement("label");
                        label.classList.add("thumbnail-choice");
                        label.setAttribute("for", "thumbnail-" + index);
                        const span = document.createElement("span");
                        span.textContent = file.name + " (" + returnFileSize(file.size) + ")";
                        const div = document.createElement("div");
                        div.classList.add('selected');
                        div.innerText = "Vignette";
                        const imgContainer = document.createElement("div");
                        imgContainer.classList.add("thumbnail-image");
                        const image = document.createElement("img");
                        image.src = URL.createObjectURL(file);
                        image.alt = image.title = file.name;
                        imgContainer.appendChild(image);

                        label.appendChild(span);
                        label.appendChild(div);
                        label.appendChild(imgContainer);

                        listItem.appendChild(radio);
                        listItem.appendChild(label);
                        index += 1;
                    } else {
                        const div = document.createElement("div");
                        div.innerHTML = `${file.name}<span class="error">${self.translations['Not a valid file type. Update your selection']}.</span>`;
                        listItem.appendChild(div);
                    }

                    list.appendChild(listItem);
                }
            }

            const fileTypes = [
                "image/jpeg",
                "image/png",
                "image/webp",
            ];

            function validFileType(file) {
                return fileTypes.includes(file.type);
            }

            function returnFileSize(number) {
                if (number < 1e3) {
                    return `${number} bytes`;
                } else if (number >= 1e3 && number < 1e6) {
                    return `${(number / 1e3).toFixed(1)} KB`;
                } else {
                    return `${(number / 1e6).toFixed(1)} MB`;
                }
            }
        });
    </script>
{% endblock %}

