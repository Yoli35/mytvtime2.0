{% extends 'base.html.twig' %}

{% block title %}my Tv Time → {{ 'Movies'|trans }} → {{ 'Discover'|trans }}{% endblock %}
{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('styles/contact.scss') }}">
    <link rel="stylesheet" href="{{ asset('styles/home.scss') }}">
    <link rel="stylesheet" href="{{ asset('styles/movie.scss') }}">
    <link rel="stylesheet" href="{{ asset('styles/movie_discover.scss') }}">
{% endblock %}
{% block body %}
    <div class="container-fluid">
        {% include '_blocks/_menu.html.twig' %}
        <div class="movie-discover">
            <h1>{{ title|trans }}</h1>
            <div class="filters">
                <div class="discover-region">
                    <div class="discover-filter">{{ 'Region'|trans }}</div>
                    {% if userCountryCode %}
                        <div class="discover-item" data-code="{{ userCountryCode }}">{{ userCountryName }} {{ getEmojiFlag(userCountryCode) }}</div>
                    {% endif %}
                </div>
                <div class="discover-release-year">
                    <div class="discover-filter">{{ 'Release'|trans }}</div>
                </div>
                <div class="discover-release-year-lte">
                    <div class="discover-filter">{{ 'Before'|trans }}</div>
                </div>
                <div class="discover-release-year-gte">
                    <div class="discover-filter">{{ 'After'|trans }}</div>
                </div>
                <div class="discover-with-cast-list">
                    <div class="discover-filter">{{ 'Cast'|trans }}</div>
                    <div class="discover-filter-switch" data-separator=",">({{ 'and'|trans }})</div>
                </div>
                <div class="discover-with-crew-list">
                    <div class="discover-filter">{{ 'Crew'|trans }}</div>
                    <div class="discover-filter-switch" data-separator=",">({{ 'and'|trans }})</div>
                </div>
                <div class="discover-with-genre-list">
                    <div class="discover-filter">{{ 'Genres'|trans }}</div>
                    <div class="discover-filter-switch" data-separator=",">({{ 'and'|trans }})</div>
                </div>
                <div class="discover-with-keyword-list">
                    <div class="discover-filter">{{ 'Keywords'|trans }}</div>
                    <div class="discover-filter-switch" data-separator=",">({{ 'and'|trans }})</div>
                </div>
                <div class="discover-origin-country">
                    <div class="discover-filter">{{ 'Country'|trans }}</div>
                </div>
                <div class="discover-origin-language">
                    <div class="discover-filter">{{ 'Language'|trans }}</div>
                </div>
                <div class="discover-sort">
                    <div class="discover-filter">{{ 'Sort'|trans }}</div>
                    <div class="discover-item" data-sort="primary_release_date.desc">{{ 'Release date (reverse)'|trans }}</div>
                </div>
                <div class="result-infos"></div>
            </div>
            <form id="discover-form">
                <div class="form-row">
                    <div class="form-field">
                        <label for="discover-region">{{ 'Your country'|trans }}
                            <select name="discover-region" id="discover-region">
                                <button>
                                    <selectedcontent></selectedcontent>
                                </button>
                                <option value="all">{{ 'Select a country'|trans }}…</option>
                                {% for code, country in countries %}
                                    <option value="{{ code }}"{% if userCountryCode == code %} selected{% endif %}>{{ country }} <span><em>{{ getEmojiFlag(code) }}</em></span></option>
                                {% endfor %}
                            </select>
                        </label>
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-field">
                        <label for="discover-release-year">{{ 'Primary release year'|trans }}
                            <input type="number" name="discover-release-year" id="discover-release-year">
                        </label>
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-field">
                        <label for="discover-release-year-lte">{{ 'Released before'|trans }}
                            <input type="date" name="discover-release-year-lte" id="discover-release-year-lte">
                        </label>
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-field">
                        <label for="discover-release-year-gte">{{ 'Released after'|trans }}
                            <input type="date" name="discover-release-year-gte" id="discover-release-year-gte">
                        </label>
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-field">
                        <label for="discover-with-cast">{{ 'Cast'|trans }}
                            <input type="search" name="discover-with-cast" id="discover-with-cast" placeholder="{{ 'Select a cast member'|trans }}…">
                            <div class="discover-switch-and-or and">
                                <div class="and">{{ 'And'|trans }}</div>
                                <div class="or">{{ 'Or'|trans }}</div>
                            </div>
                        </label>
                        <div class="search-results">
                            <ul data-type="people"></ul>
                        </div>
                        <div class="discover-with-cast-list">
                        </div>
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-field">
                        <label for="discover-with-crew">{{ 'Crew'|trans }}
                            <input type="search" name="discover-with-crew" id="discover-with-crew" placeholder="{{ 'Select a crew member'|trans }}…">
                            <div class="discover-switch-and-or and">
                                <div class="and">{{ 'And'|trans }}</div>
                                <div class="or">{{ 'Or'|trans }}</div>
                            </div>
                        </label>
                        <div class="search-results">
                            <ul data-type="people"></ul>
                        </div>
                        <div class="discover-with-crew-list">
                        </div>
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-field">
                        <label for="discover-with-genre">{{ 'Genres'|trans }}
                            <select name="discover-with-genre" id="discover-with-genre">
                                <option value="all">{{ 'Add a genre'|trans }}</option>
                                {% for code, genre in genres %}
                                    <option value="{{ code }}">{{ genre }}</option>
                                {% endfor %}
                            </select>
                            <div class="discover-switch-and-or and">
                                <div class="and">{{ 'And'|trans }}</div>
                                <div class="or">{{ 'Or'|trans }}</div>
                            </div>
                        </label>
                        <div class="discover-with-genre-list" data-switch="and">
                        </div>
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-field">
                        <label for="discover-with-keyword">{{ 'Keywords'|trans }}
                            <input type="search" name="discover-with-keyword" id="discover-with-keyword">
                            <div class="discover-switch-and-or and">
                                <div class="and">{{ 'And'|trans }}</div>
                                <div class="or">{{ 'Or'|trans }}</div>
                            </div>
                        </label>
                        <div class="search-results">
                            <ul data-type="keyword"></ul>
                        </div>
                        <div class="discover-with-keyword-list">
                        </div>
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-field">
                        <label for="discover-origin-country">{{ 'Origin country'|trans }}
                            <select name="discover-origin-country" id="discover-origin-country">
                                <button>
                                    <selectedcontent></selectedcontent>
                                </button>
                                <option value="all">{{ 'Select a country'|trans }}…</option>
                                {% for code, country in countries %}
                                    <option value="{{ code }}">{{ country }} <span><em>{{ getEmojiFlag(code) }}</em></span></option>
                                {% endfor %}
                            </select>
                        </label>
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-field">
                        <label for="discover-origin-language">{{ 'Origin language'|trans }}
                            <select name="discover-origin-language" id="discover-origin-language">
                                <option value="all">{{ 'Select a language'|trans }}…</option>
                                {% for code, language in languages %}
                                    <option value="{{ code }}">{{ language }}</option>
                                {% endfor %}
                            </select>
                        </label>
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-field">
                        <label for="discover-sort">{{ 'Sort'|trans }}
                            <select name="discover-sort" id="discover-sort">
                                <option value="title.asc">{{ 'Title (ascending)'|trans }}</option>
                                <option value="title.desc">{{ 'Title (descending)'|trans }}</option>
                                <option value="original_title.asc">{{ 'Original title (ascending)'|trans }}</option>
                                <option value="original_title.desc">{{ 'Original title (descending)'|trans }}</option>
                                <option value="popularity.asc">{{ 'Popularity'|trans }}</option>
                                <option value="popularity.desc">{{ 'Popularity (reverse)'|trans }}</option>
                                <option value="primary_release_date.asc">{{ 'Release date'|trans }}</option>
                                <option value="primary_release_date.desc" selected>{{ 'Release date (reverse)'|trans }}</option>
                                <option value="revenue.asc">{{ 'Vote average'|trans }}</option>
                                <option value="revenue.desc">{{ 'Vote average (reverse)'|trans }}</option>
                                <option value="vote_average.asc">{{ 'Vote average'|trans }}</option>
                                <option value="vote_average.desc">{{ 'Vote average (reverse)'|trans }}</option>
                                <option value="vote_count.asc">{{ 'Vote count'|trans }}</option>
                                <option value="vote_count.desc">{{ 'Vote count (reverse)'|trans }}</option>
                            </select>
                        </label>
                    </div>
                </div>
                <div class="form-row">
                    <div id="discover-list" class="discover-tools">{{ ux_icon('mdi:view-list') }}</div>
                    <div id="discover-grid" class="discover-tools">{{ ux_icon('mdi:view-grid') }}</div>
                    <div id="discover-fold" class="discover-tools">{{ ux_icon('mdi:chevron-double-right') }}</div>
                </div>
                <button id="discover-submit" data-page="1">{{ ux_icon('mdi:search') }}</button>
                <div class="result-infos"></div>
            </form>
            <div class="movie-search-result">
                <div class="wrapper">

                </div>
            </div>
        </div>
    </div>
    <div id="svgs" style="display: none;">
        <div class="svg-close">{{ ux_icon('mdi:close') }}</div>
        <div class="svg-chevron-left">{{ ux_icon('mdi:chevron-left') }}</div>
        <div class="svg-chevron-right">{{ ux_icon('mdi:chevron-right') }}</div>
    </div>
    {% include '_blocks/_footer.html.twig' %}
{% endblock %}
