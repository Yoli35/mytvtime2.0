{% extends 'base.html.twig' %}

{% block title %}my Tv Time → {{ 'Register'|trans }}{% endblock %}

{% block body %}
    {% include('_blocks/_menu.html.twig') %}
    <div class="container-fluid" style="background-image: url('{{ bgImage }}'); background-size: cover; background-position: center;">
        {% for flash_error in app.flashes('verify_email_error') %}
            <div class="alert alert-danger" role="alert">{{ flash_error }}</div>
        {% endfor %}
        <div class="register">
            {{ form_start(registrationForm) }}
            <div class="error">
                {{ form_errors(registrationForm) }}
            </div>
            <div class="header">{{ 'Register'|trans }}</div>
            <div class="body">
                <label for="{{ registrationForm.username.vars.id }}" class="required">{{ 'Username'|trans }}
                    <input type="text" name="{{ field_name(registrationForm.username) }}" id="{{ registrationForm.username.vars.id }}" value="{{ registrationForm.username.vars.value }}" placeholder="{{ registrationForm.username.vars.attr.placeholder|trans }}" autocomplete="new-password" required>
                    {{ form_errors(registrationForm.username) }}
                </label>
                <label for="{{ registrationForm.email.vars.id }}" class="required">{{ 'Email'|trans }}
                    <input type="text" name="{{ field_name(registrationForm.email) }}" id="{{ registrationForm.email.vars.id }}" value="{{ registrationForm.email.vars.value }}" placeholder="{{ registrationForm.email.vars.attr.placeholder|trans }}" autocomplete="new-password" required>
                    {{ form_errors(registrationForm.email) }}
                </label>
                <label for="{{ registrationForm.plainPassword.vars.id }}" class="required">{{ 'Password'|trans }}
                    <input type="password"
                           minlength="12"
                           pattern="^(?=.*[A-Za-z])(?=.*\d).+$"
                           name="{{ field_name(registrationForm.plainPassword) }}"
                           id="{{ registrationForm.plainPassword.vars.id }}"
                           placeholder="{{ registrationForm.plainPassword.vars.attr.placeholder|trans }}"
                           autocomplete="new-password"
                           required>
                    <div class="password-toggle-view"><i class="fas fa-eye"></i></div>
                    {{ form_errors(registrationForm.plainPassword) }}
                </label>
                <label for="{{ registrationForm.confirmPassword.vars.id }}" class="required">{{ 'Password'|trans }}
                    <input type="password"
                           minlength="12"
                           pattern="^(?=.*[A-Za-z])(?=.*\d).+$"
                           name="{{ field_name(registrationForm.confirmPassword) }}"
                           id="{{ registrationForm.confirmPassword.vars.id }}"
                           placeholder="{{ registrationForm.confirmPassword.vars.attr.placeholder|trans }}"
                           autocomplete="new-password"
                           required>
                    <div class="password-toggle-view"><i class="fas fa-eye"></i></div>
                    {{ form_errors(registrationForm.confirmPassword) }}
                </label>
                <label for="{{ registrationForm.country.vars.id }}" class="{{ registrationForm.country.vars.required ? 'required' }}">
                    <div>{{ registrationForm.country.vars.label|trans }}</div>
                    {% if registrationForm.country.vars.help %}
                        <div class="help">{{ registrationForm.country.vars.help|trans }}</div>
                    {% endif %}
                    {{ form_widget(registrationForm.country) }}
                </label>
                <label for="{{ registrationForm.preferredLanguage.vars.id }}" class="{{ registrationForm.preferredLanguage.vars.required ? 'required' }}">
                    <div>{{ registrationForm.preferredLanguage.vars.label|trans }}</div>
                    {% if registrationForm.preferredLanguage.vars.help %}
                        <div class="help">{{ registrationForm.preferredLanguage.vars.help|trans }}</div>
                    {% endif %}
                    {{ form_widget(registrationForm.preferredLanguage) }}
                </label>
                <label for="{{ registrationForm.timezone.vars.id }}" class="{{ registrationForm.timezone.vars.required ? 'required' }}">
                    <div>{{ registrationForm.timezone.vars.label|trans }}</div>
                    {% if registrationForm.timezone.vars.help %}
                        <div class="help">{{ registrationForm.timezone.vars.help|trans }}</div>
                    {% endif %}
                    {{ form_widget(registrationForm.timezone) }}
                </label>
                {# Anti-bot: honeypot (hidden from humans and screen readers) + signed display timestamp #}
                <div class="hp-field" aria-hidden="true">
                    <label for="{{ registrationForm.website.vars.id }}">Website</label>
                    <input type="text" name="{{ field_name(registrationForm.website) }}" id="{{ registrationForm.website.vars.id }}" value="" tabindex="-1" autocomplete="off">
                </div>
                {{ form_widget(registrationForm.startedAt) }}
                <div class="remember-me">
                    <label for="{{ registrationForm.agreeTerms.vars.id }}">
                        <input type="checkbox" switch checked name="{{ field_name(registrationForm.agreeTerms) }}" id="{{ registrationForm.agreeTerms.vars.id }}">
                        <span>{{ registrationForm.agreeTerms.vars.label|trans }}</span>
                    </label>
                    {{ form_errors(registrationForm.agreeTerms) }}
                </div>
            </div>
            <div class="footer">
                <button type="button"><a href="{{ path('app_home_index') }}">{{ 'Home'|trans }}</a></button>
                <button type="button"><a href="{{ path('app_login') }}">{{ 'Connect'|trans }}</a></button>
                <button type="submit" class="btn">{{ 'Register'|trans }}</button>
            </div>
            {{ form_end(registrationForm) }}
        </div>
    </div>
    {% include('_blocks/_footer.html.twig') %}
{% endblock %}
{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('js/password-toggle-view.js') }}"></script>
{% endblock %}

